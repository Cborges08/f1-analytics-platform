# OpenF1 API
OPENF1_BASE_URL=https://api.openf1.org/v1

# Ergast API
ERGAST_BASE_URL=https://ergast.com/api/f1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=f1_analytics
POSTGRES_USER=f1_user
POSTGRES_PASSWORD=your_password_here

# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=f1-analytics-raw-data

# API
API_PORT=3001
API_SECRET_KEY=your_secret_here

# Environment
NODE_ENV=development